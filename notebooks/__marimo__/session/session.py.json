    {
      "id": "lEQa",
      "code_hash": "2747333bb85c124965f877059a277340",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"the-same-file-as-math\">The same file, as math</h2>\n<span class=\"paragraph\">Printed by the language, from the file alone: no data binds and nothing is solved.</span>\n<span class=\"paragraph\">least-cost dispatch: four generators meet a load over one day</span>\n<h4 id=\"objective\">Objective</h4>\n<marimo-tex class=\"arithmatex\">||[\n\\min \\sum_{t \\in \\mathcal{T},\\ g \\in \\mathcal{G}} \\mathrm{cost}_{g} \\cdot p_{t,g}\n||]</marimo-tex><h4 id=\"subject-to\">Subject to</h4>\n<span class=\"paragraph\"><strong><code>capacity</code></strong></span>\n<marimo-tex class=\"arithmatex\">||[\np_{t,g} \\le \\mathrm{p}^{\\mathrm{max}}_{g} \\cdot \\mathrm{avail}_{t,g} \\qquad \\forall\\, t \\in \\mathcal{T},\\ g \\in \\mathcal{G}\n||]</marimo-tex><span class=\"paragraph\"><strong><code>balance</code></strong></span>\n<marimo-tex class=\"arithmatex\">||[\n\\sum_{g \\in \\mathcal{G}} p_{t,g} = \\mathrm{load}_{t} \\qquad \\forall\\, t \\in \\mathcal{T}\n||]</marimo-tex><h4 id=\"definitions\">Definitions</h4>\n<span class=\"paragraph\"><strong><code>emissions</code></strong></span>\n<marimo-tex class=\"arithmatex\">||[\n\\mathit{emissions} = \\sum_{t \\in \\mathcal{T},\\ g \\in \\mathcal{G}} \\mathrm{rate}_{g} \\cdot p_{t,g}\n||]</marimo-tex><h4 id=\"variable-domains\">Variable domains</h4>\n<span class=\"paragraph\"><strong><code>p</code></strong></span>\n<marimo-tex class=\"arithmatex\">||[\np_{t,g} \\ge 0 \\qquad \\forall\\, t \\in \\mathcal{T},\\ g \\in \\mathcal{G}\n||]</marimo-tex></span>"
          }
        }
      ],
      "console": []
    },
